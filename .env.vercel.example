# Reference only. NOT automatically loaded. Supply real values securely at deployment.
# Separate production and preview environments, databases, domains and secrets.
DJANGO_SETTINGS_MODULE=config.vercel
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_EXACT_DEPLOYMENT_HOST
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_EXACT_DEPLOYMENT_HOST
# URL-encode username/password. Prefer provider-supported verify-full with trusted CA.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/REPLACE_DATABASE?sslmode=verify-full
# Optional provider CA file path when a custom CA is required; never disable TLS.
# DJANGO_DATABASE_SSLROOTCERT=/path/to/approved/provider-ca.pem
CRON_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
